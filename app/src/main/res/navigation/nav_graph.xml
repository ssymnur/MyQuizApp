<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/entryFragment">

    <!-- Entry Fragment -->
    <fragment
        android:id="@+id/entryFragment"
        android:name="com.quiz.myquizapp.fragment.entry.EntryFragment"
        android:label="fragment_entry"
        tools:layout="@layout/fragment_entry" >
        <action
            android:id="@+id/action_entryFragment_to_listFragment"
            app:destination="@id/listFragment" />
    </fragment>

    <!-- List Fragment -->
    <fragment
        android:id="@+id/listFragment"
        android:name="com.quiz.myquizapp.ListFragment"
        android:label="fragment_list"
        tools:layout="@layout/fragment_list" >
        <action
            android:id="@+id/action_listFragment_to_questionsFragment"
            app:destination="@id/questionsFragment" />
    </fragment>

    <!-- Questions Fragment -->
    <fragment
        android:id="@+id/questionsFragment"
        android:name="com.quiz.myquizapp.questions.QuestionsFragment"
        android:label="QuestionsFragment"
        tools:layout="@layout/fragment_questions">

        <!-- Argument ekledik -->
        <argument
            android:name="selectedCategory"
            app:argType="string" />
    </fragment>

</navigation>

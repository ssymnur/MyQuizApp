<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFF6F9"
    android:padding="16dp">


    <!-- Timer -->

    <TextView
        android:id="@+id/textViewTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:00"
        android:textSize="30sp"
        android:textColor="#0D47A1"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>


    <!-- Progress Text -->
    <TextView
        android:id="@+id/textViewQuestionProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Soru 1 / 10"
        android:textSize="16sp"
        android:textColor="#0D47A1"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"/>

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:max="100"
        android:progress="30"
        android:scaleY="3"
        android:progressTint="#0D47A1"
        android:backgroundTint="#E1BEE7"
        android:layout_marginBottom="16dp"
        android:clipToOutline="true" />


    <!-- Soru -->
    <TextView
        android:id="@+id/textViewQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Soru burada"
        android:textSize="20sp"
        android:textColor="#333333"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <!-- Görsel -->
    <ImageView
        android:id="@+id/imageViewQuestion"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="fitCenter"
        android:visibility="invisible"
        android:layout_marginBottom="16dp"/>

    <!-- Seçenekler -->
    <Button
        android:id="@+id/buttonOptionA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/buttonOptionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="B"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/buttonOptionC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="C"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/buttonOptionD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="D"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Navigation butonları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/buttonPrevious"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#5DADE2"
            android:text="Önceki"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/buttonFinish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bitir"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF"

            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/buttonNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sonraki"
            android:backgroundTint="#5DADE2"
            android:textColor="#ffffff"/>
    </LinearLayout>


</LinearLayout>


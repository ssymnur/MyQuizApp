<?xml version="1.0" encoding="utf-8"?>
    <!-- Root FrameLayout ile başlıyoruz ki overlay’i ekran üstüne tam koyabilelim -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ana içerik LinearLayout -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Üst kısım: Avatar ve karşılama metni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/imageViewAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="4dp"
                android:src="@drawable/default_avatar" />

            <TextView
                android:id="@+id/textViewWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hoş geldin!"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- Kullanıcı puan ve seviye bilgisi ve günlük hediye butonu yan yana -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/textViewStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Puan: 0   🎖️ Seviye: 1 "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#444444" />

            <Button
                android:id="@+id/dailyGiftButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁"
                android:textSize="24sp"
                android:layout_marginStart="16dp"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- Zorluk seçimi butonları (widget gibi) -->
        <LinearLayout
            android:id="@+id/difficultyWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/easyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Kolay"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/mediumButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Orta"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/hardButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zor"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Kategoriler listesi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Alt menü -->
        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#0D47A1">

            <ImageView
                android:id="@+id/imageViewLeaderboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_star"
                android:contentDescription="LeaderBoard"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/imageViewLogout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_exit"
                android:contentDescription="Çıkış Yap"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/imageViewProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profil"
                android:padding="8dp"
                android:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Konfeti overlay - ROOT içinde, diğer layoutların üstünde, tam ekran -->
    <FrameLayout
        android:id="@+id/confettiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@android:color/white"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:gravity="center"
            android:layout_margin="16dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/confettiAnimationView"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:lottie_rawRes="@raw/confetti"
                app:lottie_autoPlay="false"
                app:lottie_loop="false" />

            <TextView
                android:id="@+id/levelUpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 Tebrikler! Seviye atladınız! 🎉"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/giftOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@android:color/white"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:gravity="center"
            android:layout_margin="16dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/giftAnimationView"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:lottie_rawRes="@raw/gift_box"
                app:lottie_autoPlay="false"
                app:lottie_loop="false" />

            <TextView
                android:id="@+id/giftPointText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 2 Puan Kazandınız! 🎉"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>


</FrameLayout>

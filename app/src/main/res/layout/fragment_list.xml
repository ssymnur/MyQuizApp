<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst kısım: Avatar ve karşılama metni -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/imageViewAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="4dp"
            android:src="@drawable/default_avatar" />

        <TextView
            android:id="@+id/textViewWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hoş geldin!"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- Kullanıcı puan ve seviye bilgisi -->
    <TextView
        android:id="@+id/textViewStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puan: 0  |  Seviye: 1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#444444"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal" />

    <!-- Zorluk seçimi butonları (widget gibi) -->
    <LinearLayout
        android:id="@+id/difficultyWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/easyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Kolay"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/mediumButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Orta"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/hardButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Zor"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Kategoriler listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Alt menü -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#0D47A1">

        <ImageView
            android:id="@+id/imageViewLeaderboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star"
            android:contentDescription="LeaderBoard"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/imageViewLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_exit"
            android:contentDescription="Çıkış Yap"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/imageViewProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_profile"
            android:contentDescription="Profil"
            android:padding="8dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>

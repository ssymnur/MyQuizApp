<?xml version="1.0" encoding="utf-8"?>
<!-- Dikey liste için vertical orientation kullanılması daha uygun -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <TextView
        android:id="@+id/leaderboardEmoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🥇 🥈 🥉 "
        android:textSize="28sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />
    <TextView
        android:id="@+id/leaderboardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Leaderboard"
        android:textSize="40sp"
        android:textStyle="bold|italic"
        android:textColor="#1B4F72"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/leaderboardRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />
    </LinearLayout>
    <Button
        android:id="@+id/buttonBackToCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kategoriye Dön"
        android:backgroundTint="#1B4F72"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:textAllCaps="false" />
</LinearLayout>
